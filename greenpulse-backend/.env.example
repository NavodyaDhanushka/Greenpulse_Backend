# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DB=greenpulse

# AWS IoT Core
AWS_IOT_ENDPOINT=xxxxxxxxxxxx-ats.iot.ap-southeast-2.amazonaws.com
AWS_IOT_PORT=8883
AWS_IOT_CLIENT_ID=greenpulse-backend
AWS_IOT_ROOT_CA=certs/AmazonRootCA1.pem
AWS_IOT_CERT=certs/xxxx-certificate.pem.crt
AWS_IOT_PRIVATE_KEY=certs/xxxx-private.pem.key

# Gmail (optional)
GMAIL_CREDENTIALS_FILE=secrets/gmail_credentials.json
GMAIL_TOKEN_FILE=secrets/gmail_token.json

# Plant location (for weather)
PLANT_LATITUDE=6.9271
PLANT_LONGITUDE=79.8612
PLANT_PLACEMENT=indoor